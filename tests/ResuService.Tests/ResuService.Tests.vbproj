<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <RootNamespace>ResuTests</RootNamespace>
    <OptionStrict>On</OptionStrict>
    <OptionInfer>On</OptionInfer>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../ui/KathanaBotControlPanel/KathanaBotControlPanel.vbproj" />
    <Compile Include="../../ui/KathanaBotControlPanel/ResuService.vb" Link="ResuService.vb" />
    <Import Include="KathanaBotControlPanel" />
  </ItemGroup>
</Project>
