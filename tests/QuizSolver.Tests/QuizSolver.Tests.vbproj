<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <RootNamespace>QuizTests</RootNamespace>
    <OptionInfer>On</OptionInfer>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../ui/KathanaBotControlPanel/KathanaBotControlPanel.vbproj" />
    <Compile Include="../../ui/KathanaBotControlPanel/QuizSolver.vb" Link="QuizSolver.vb" />
    <Compile Include="../../ui/KathanaBotControlPanel/QuizAnswerPolicy.vb" Link="QuizAnswerPolicy.vb" />
    <Import Include="KathanaBotControlPanel" />
    <Import Include="System.Drawing" />
  </ItemGroup>
</Project>
