<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <RootNamespace>KathanaBotControlPanel</RootNamespace>
    <StartupObject>Sub Main</StartupObject>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <Import Include="System.Data" />
    <Import Include="System.Drawing" />
    <Import Include="System.Windows.Forms" />
  </ItemGroup>

  <Target Name="CopyUiArtifactsToRepoRoot" AfterTargets="Build">
    <PropertyGroup>
      <RepoRoot>$(MSBuildProjectDirectory)\..\..\</RepoRoot>
      <ArtifactSourceDir>$(TargetDir)</ArtifactSourceDir>
    </PropertyGroup>

    <ItemGroup>
      <UiArtifacts Include="$(ArtifactSourceDir)$(AssemblyName).exe" />
      <UiArtifacts Include="$(ArtifactSourceDir)$(AssemblyName).dll" />
      <UiArtifacts Include="$(ArtifactSourceDir)$(AssemblyName).deps.json" />
      <UiArtifacts Include="$(ArtifactSourceDir)$(AssemblyName).runtimeconfig.json" />
    </ItemGroup>

    <Copy
      SourceFiles="@(UiArtifacts)"
      DestinationFolder="$(RepoRoot)"
      SkipUnchangedFiles="false"
      OverwriteReadOnlyFiles="true"
      ContinueOnError="WarnAndContinue" />
  </Target>

</Project>
