<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <RootNamespace>KathanaBotControlPanel</RootNamespace>
    <StartupObject>Sub Main</StartupObject>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>assets\KathanaBot.ico</ApplicationIcon>
    <Version>1.0.258</Version>
    <FileVersion>1.0.250.0</FileVersion>
    <AssemblyVersion>1.0.250.0</AssemblyVersion>
    <InputBuildVariant>FocusBorrow</InputBuildVariant>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <Import Include="System.Data" />
    <Import Include="System.Drawing" />
    <Import Include="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>QuizSolver.Tests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Extras.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="**\* - Copy.vb" />
    <EmbeddedResource Remove="**\* - Copy.*" />
    <None Remove="**\* - Copy.*" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="assets\Extras\engine-x2.cfg">
      <LogicalName>KathanaBotControlPanel.Extras.engine-x2.cfg</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="assets\Extras\engine-x3.cfg">
      <LogicalName>KathanaBotControlPanel.Extras.engine-x3.cfg</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\RemoteDesktopMosaic_20261007_AllScreens.exe">
      <LogicalName>KathanaBotControlPanel.Extras.RemoteDesktopMosaic.exe</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\RemoteDesktopMosaic_20261007_AllScreens.exe.sha256">
      <LogicalName>KathanaBotControlPanel.Extras.RemoteDesktopMosaic.exe.sha256</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="DefaultUserSettings.json">
      <LogicalName>KathanaBotControlPanel.DefaultUserSettings.json</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="assets\BuffWatchIcons.zip">
      <LogicalName>KathanaBotControlPanel.BuffWatchIcons.zip</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="QuizKnowledge.dat">
      <LogicalName>KathanaBotControlPanel.QuizKnowledge.dat</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\tools\discord-browser-capture\*.mjs;..\..\tools\discord-browser-capture\*.html;..\..\tools\discord-browser-capture\*.css;..\..\tools\discord-browser-capture\*.json;..\..\tools\discord-browser-capture\README.md">
      <LogicalName>KathanaBotControlPanel.DiscordCapture.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
