<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <RootNamespace>KathanaBotControlPanel</RootNamespace>
    <StartupObject>Sub Main</StartupObject>
    <UseWindowsForms>true</UseWindowsForms>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>

  <ItemGroup>
    <Import Include="System.Data" />
    <Import Include="System.Drawing" />
    <Import Include="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="**\* - Copy.vb" />
    <EmbeddedResource Remove="**\* - Copy.*" />
    <None Remove="**\* - Copy.*" />
  </ItemGroup>

  <Target Name="CopyUiArtifactsToRepoRoot" AfterTargets="Build">
    <PropertyGroup>
      <RepoRoot>$(MSBuildProjectDirectory)\..\..\</RepoRoot>
      <ArtifactSourceDir>$(TargetDir)</ArtifactSourceDir>
    </PropertyGroup>

    <ItemGroup>
      <!-- Copy all first-level build outputs so runtime dependencies are present in repo root. -->
      <UiArtifacts Include="$(ArtifactSourceDir)*.*" />
    </ItemGroup>

    <Copy SourceFiles="@(UiArtifacts)" DestinationFolder="$(RepoRoot)" SkipUnchangedFiles="false" OverwriteReadOnlyFiles="true" ContinueOnError="WarnAndContinue" />
  </Target>

</Project>
